<% if (theme.highlight_copy) { %>
  <%- js(theme.js.clipboard) %>
  <script type="module">
    import copyFn from "/js/copyFn.js";
    copyFn("<%- _p('copy') %>", "<%- _p('copy_success') %>", "<%- _p('copy_error') %>");
  </script>
<% } %>
